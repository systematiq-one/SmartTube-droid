<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- App bar: back, query field, clear, mic, filters -->
    <LinearLayout
        android:id="@+id/search_app_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp">

        <ImageButton
            android:id="@+id/search_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back_desc"
            android:scaleType="center"
            android:src="@drawable/search_ic_back"
            android:tint="?attr/colorControlNormal" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/action_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/search_clear_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear_desc"
            android:scaleType="center"
            android:src="@drawable/search_ic_clear"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/search_voice_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_voice_desc"
            android:scaleType="center"
            android:src="@drawable/search_ic_mic"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/search_filter_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_filters_desc"
            android:scaleType="center"
            android:src="@drawable/search_ic_filter"
            android:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <!-- Search tag chips (history + suggestions) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_tags_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:scrollbars="none" />

    <!-- Results grid + progress -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/search_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
