<?xml version="1.0" encoding="utf-8"?>
<!-- Plain text row. Used by TYPE_SINGLE_BUTTON (context-menu entries), TYPE_STRING_LIST
     (clickable strings) and the TYPE_CHAT/TYPE_COMMENTS "not supported yet" placeholder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dialog_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody1" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dialog_row_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:visibility="gone" />

</LinearLayout>
