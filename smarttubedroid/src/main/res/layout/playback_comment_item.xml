<?xml version="1.0" encoding="utf-8"?>
<!--
    One comment inside the expanded comments panel (playback_details_sheet).

    Tap opens the replies, long press toggles the like - both handled by CommentsAdapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/playback_comment_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/playback_channel_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playback_comment_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/playback_control_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playback_comment_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/playback_control"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/playback_comment_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/playback_comment_like_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/playback_ic_like" />

            <TextView
                android:id="@+id/playback_comment_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:textColor="@color/playback_control_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/playback_comment_replies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:textColor="@color/playback_control"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
