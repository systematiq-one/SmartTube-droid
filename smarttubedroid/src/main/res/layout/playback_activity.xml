<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone player screen.

    Portrait: 16:9 video pinned to the top + a metadata panel below (title, second title,
    channel row, action chips, suggestions rows).
    Landscape: the player container fills the screen and the panel is hidden
    (see PlaybackActivity.applyOrientation()).

    The ExoPlayer surface is a DoubleTapPlayerViewImpl with its own controller disabled —
    all controls live in the custom overlay (playback_overlay.xml).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/playback_player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Background poster shown while the engine has no picture yet -->
        <ImageView
            android:id="@+id/playback_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.github.vkay94.dtpv.DoubleTapPlayerViewImpl
            android:id="@+id/playback_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Own subtitle view: PlayerView's internal one is hidden to avoid double rendering -->
        <com.google.android.exoplayer2.ui.SubtitleView
            android:id="@+id/playback_subtitles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Double-tap ±seek ripple (driven by DoubleTapPlayerAdapter in PlaybackGestureHandler) -->
        <com.github.vkay94.dtpv.youtube.YouTubeOverlay
            android:id="@+id/playback_youtube_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include layout="@layout/playback_overlay" />

        <ProgressBar
            android:id="@+id/playback_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Volume / brightness / speed-boost indicator -->
        <LinearLayout
            android:id="@+id/playback_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/playback_indicator_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/playback_indicator_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/playback_ic_volume" />

            <TextView
                android:id="@+id/playback_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:textColor="@color/playback_control"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- portrait-only panel -->
    <LinearLayout
        android:id="@+id/playback_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/playback_panel_bg"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playback_player_container">

        <TextView
            android:id="@+id/playback_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/playback_panel_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/playback_second_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/playback_panel_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/playback_channel_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/playback_channel_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/playback_channel_placeholder"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/playback_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/playback_panel_text"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playback_chip_subscribe"
                style="@style/Widget.SmartTubeDroid.Pill.Primary"
                android:text="@string/action_subscribe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playback_chip_more"
                style="@style/Widget.SmartTubeDroid.Pill.Icon"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@string/playback_more"
                app:icon="@drawable/playback_ic_more" />
        </LinearLayout>

        <!-- Labelled tonal pills. Toggled-on ones switch to the active container in code -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:paddingEnd="16dp"
            android:paddingRight="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/playback_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/playback_chip_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/playback_pill_group_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playback_chip_like"
                        style="@style/Widget.SmartTubeDroid.Pill.Half"
                        android:paddingEnd="12dp"
                        android:paddingRight="12dp"
                        android:contentDescription="@string/action_like"
                        app:icon="@drawable/playback_ic_like" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="@color/playback_divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playback_chip_dislike"
                        style="@style/Widget.SmartTubeDroid.Pill.Half"
                        android:paddingStart="12dp"
                        android:paddingLeft="12dp"
                        android:paddingEnd="14dp"
                        android:paddingRight="14dp"
                        android:contentDescription="@string/action_dislike"
                        app:icon="@drawable/playback_ic_dislike"
                        app:iconPadding="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playback_chip_share"
                    style="@style/Widget.SmartTubeDroid.Pill"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/share_link"
                    android:text="@string/playback_chip_share"
                    app:icon="@drawable/playback_ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playback_chip_quality"
                    style="@style/Widget.SmartTubeDroid.Pill"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/playback_quality"
                    android:text="@string/playback_quality"
                    app:icon="@drawable/playback_ic_hd" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playback_chip_speed"
                    style="@style/Widget.SmartTubeDroid.Pill"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/action_video_speed"
                    android:text="@string/playback_chip_speed"
                    app:icon="@drawable/playback_ic_speed" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playback_chip_playlist"
                    style="@style/Widget.SmartTubeDroid.Pill"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/action_playlist_add"
                    android:text="@string/playback_chip_save"
                    app:icon="@drawable/playback_ic_bookmark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playback_chip_background"
                    style="@style/Widget.SmartTubeDroid.Pill"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/background_listening"
                    android:text="@string/playback_chip_listen"
                    app:icon="@drawable/playback_ic_headphones" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Spacer: the tonal cards below carry their own margins -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Collapsed description teaser. Tapping it opens playback_details_sheet. -->
        <LinearLayout
            android:id="@+id/playback_description_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/playback_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/playback_description_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="2sp"
                android:maxLines="2"
                android:textColor="@color/playback_panel_text"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@null"
                android:src="@drawable/playback_ic_expand" />
        </LinearLayout>

        <!-- Gap between the cards (shown together with the description card) -->
        <View
            android:id="@+id/playback_description_divider"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:visibility="gone" />

        <!-- Collapsed comments row. Comments load only once this is tapped. -->
        <LinearLayout
            android:id="@+id/playback_comments_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/playback_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingLeft="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/playback_comments"
                android:textColor="@color/playback_panel_text"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@null"
                android:src="@drawable/playback_ic_expand" />
        </LinearLayout>

        <!-- Gap above the suggestions (shown together with the comments card) -->
        <View
            android:id="@+id/playback_comments_divider"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playback_suggestions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!--
        Expanded description / comments.

        Constrained to exactly the same box as playback_panel, so it covers the suggestions
        and nothing else: the player container above keeps its picture and keeps playing.
    -->
    <LinearLayout
        android:id="@+id/playback_details_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/playback_panel_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playback_player_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingLeft="12dp"
            android:paddingEnd="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/playback_details_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/playback_panel_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/playback_details_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/playback_details_close"
                android:padding="10dp"
                android:src="@drawable/playback_ic_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/playback_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/playback_details_description_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/playback_details_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:padding="12dp"
                    android:textColor="@color/playback_panel_text_dim"
                    android:textColorLink="@color/playback_panel_text"
                    android:textSize="14sp" />
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playback_details_comments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/playback_details_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/playback_panel_text_dim"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/playback_details_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
