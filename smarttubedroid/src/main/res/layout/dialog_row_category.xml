<?xml version="1.0" encoding="utf-8"?>
<!-- Category row of the root dialog screen. Tapping pushes the category contents
     as a new screen on the fragment's internal stack. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingLeft="20dp"
    android:paddingRight="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dialog_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dialog_row_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/dialog_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/dialog_ic_chevron"
        android:tint="?attr/colorOnSurface" />

</LinearLayout>
