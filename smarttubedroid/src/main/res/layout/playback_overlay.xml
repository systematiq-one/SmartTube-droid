<?xml version="1.0" encoding="utf-8"?>
<!--
    Player controls overlay. Included on top of the player surface by playback_activity.xml.
    Visibility is driven by PlaybackActivity.showOverlay()/showControls() with a 3s auto-hide
    while playing. Every button reports to PlaybackPresenter.onButtonClicked(R.id.action_*, state)
    using common's action id vocabulary.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playback_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- top row -->
    <LinearLayout
        android:id="@+id/playback_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/playback_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/playback_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playback_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_back" />

        <TextView
            android:id="@+id/playback_overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/playback_control"
            android:textSize="14sp" />

        <!-- Quality moved to the overflow menu: this slot is the speed toggle
             (tap = last used speed, long press = the speed list) -->
        <ImageButton
            android:id="@+id/playback_btn_speed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_video_speed"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_speed" />

        <ImageButton
            android:id="@+id/playback_btn_captions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_captions" />

        <ImageButton
            android:id="@+id/playback_btn_mute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_sound_off"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_mute" />

        <ImageButton
            android:id="@+id/playback_btn_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_playlist_add"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_bookmark" />

        <ImageButton
            android:id="@+id/playback_btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playback_more"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_more" />
    </LinearLayout>

    <!-- center transport -->
    <LinearLayout
        android:id="@+id/playback_center_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/playback_btn_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_prev" />

        <ImageButton
            android:id="@+id/playback_btn_play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="24dp"
            android:layout_marginLeft="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginRight="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_play" />

        <ImageButton
            android:id="@+id/playback_btn_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/playback_ic_next" />
    </LinearLayout>

    <!-- bottom bar -->
    <LinearLayout
        android:id="@+id/playback_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/playback_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingLeft="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/playback_seek_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingLeft="8dp"
            android:paddingEnd="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/playback_control"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/playback_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingLeft="8dp"
            android:paddingEnd="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/playback_control_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playback_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingLeft="8dp"
                android:paddingEnd="4dp"
                android:paddingRight="4dp"
                android:text="@string/playback_time_zero"
                android:textColor="@color/playback_control"
                android:textSize="12sp" />

            <com.liskovsoft.smartyoutubetv2.droid.ui.playback.PlaybackSeekBar
                android:id="@+id/playback_seekbar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progressDrawable="@drawable/playback_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/playback_seekbar_thumb" />

            <TextView
                android:id="@+id/playback_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingLeft="4dp"
                android:paddingEnd="4dp"
                android:paddingRight="4dp"
                android:text="@string/playback_time_zero"
                android:textColor="@color/playback_control"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/playback_ending_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingLeft="4dp"
                android:paddingEnd="4dp"
                android:paddingRight="4dp"
                android:textColor="@color/playback_control_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/playback_btn_fullscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/playback_fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/playback_ic_fullscreen" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
