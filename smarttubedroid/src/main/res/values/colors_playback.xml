<?xml version="1.0" encoding="utf-8"?>
<!-- Playback screen colors (playback_ prefix per module resource-naming contract) -->
<resources>
    <!-- Accent for toggled-ON player buttons (matches app brand red) -->
    <color name="playback_accent">#FFFF0000</color>
    <!-- Default player control tint -->
    <color name="playback_control">#FFFFFFFF</color>
    <!-- Secondary/dimmed control + text tint -->
    <color name="playback_control_dim">#B3FFFFFF</color>
    <!-- Controls overlay scrim -->
    <color name="playback_scrim">#99000000</color>
    <!-- Portrait metadata panel (below the video): follows the phone theme, dark values in values-night -->
    <color name="playback_panel_bg">#FFFFFFFF</color>
    <color name="playback_panel_text">#FF0F0F0F</color>
    <color name="playback_panel_text_dim">#99000000</color>
    <!-- Thin divider inside the portrait panel -->
    <color name="playback_divider">#1F000000</color>
    <!-- Unplayed part of the seek bar -->
    <color name="playback_seek_track">#4DFFFFFF</color>
    <!-- Buffered part of the seek bar -->
    <color name="playback_seek_buffer">#80FFFFFF</color>
    <!-- Dark navigation bar icons over the light panel -->
    <bool name="playback_light_panel">true</bool>
</resources>
