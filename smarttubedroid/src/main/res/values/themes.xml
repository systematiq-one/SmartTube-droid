<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base activities extend FragmentActivity (not AppCompatActivity), so Material
         widgets must be used with explicit com.google.android.material tags in layouts -->
    <style name="Theme.SmartTubeDroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shared_primary</item>
        <item name="colorPrimaryVariant">#CC0000</item>
        <item name="colorSecondary">@color/shared_primary</item>
        <item name="colorSecondaryVariant">#CC0000</item>
        <!-- Tonal surfaces (values/colors_shared.xml), light and dark -->
        <item name="colorSurface">@color/shared_surface</item>
        <item name="colorOnSurface">@color/shared_on_surface</item>
        <item name="android:colorBackground">@color/shared_surface</item>
        <item name="colorOnBackground">@color/shared_on_surface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.SmartTubeDroid.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- DayNight: the panel under the video follows the phone theme. The video area and its
         controls stay dark (black window, white controls), and so does the status bar above it -->
    <style name="Theme.SmartTubeDroid.Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shared_primary</item>
        <item name="colorSecondary">@color/shared_primary</item>
        <item name="colorSurface">@color/shared_surface</item>
        <item name="colorOnSurface">@color/shared_on_surface</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@color/playback_panel_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/playback_light_panel</item>
    </style>

    <style name="Theme.SmartTubeDroid.Dialog" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shared_primary</item>
        <item name="colorSecondary">@color/shared_primary</item>
        <item name="colorSurface">@color/shared_surface_container</item>
        <item name="colorOnSurface">@color/shared_on_surface</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Tonal pill: the labelled action buttons under the video. Toggled-on pills switch to
         shared_active_container in code (PlaybackActivity.applyPillStyle) -->
    <style name="Widget.SmartTubeDroid.Pill" parent="Widget.MaterialComponents.Button.UnelevatedButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/shared_on_surface</item>
        <item name="android:maxLines">1</item>
        <item name="backgroundTint">@color/shared_surface_container_high</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/shared_on_surface</item>
        <item name="rippleColor">#1F808080</item>
    </style>

    <!-- Icon-only round variant (channel menu) -->
    <style name="Widget.SmartTubeDroid.Pill.Icon">
        <item name="android:layout_width">40dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- Half of the like/dislike pill: the group draws the pill, the halves stay transparent -->
    <style name="Widget.SmartTubeDroid.Pill.Half">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- The filled red Subscribe pill -->
    <style name="Widget.SmartTubeDroid.Pill.Primary">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textColor">@color/shared_on_primary</item>
        <item name="backgroundTint">@color/shared_primary</item>
    </style>

    <!-- Section tabs drawn as chips (see browse_tab_bg) -->
    <style name="TextAppearance.SmartTubeDroid.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
