<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base activities extend FragmentActivity (not AppCompatActivity), so Material
         widgets must be used with explicit com.google.android.material tags in layouts -->
    <style name="Theme.SmartTubeDroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF0000</item>
        <item name="colorPrimaryVariant">#CC0000</item>
        <item name="colorSecondary">#FF0000</item>
        <item name="colorSecondaryVariant">#CC0000</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.SmartTubeDroid.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- DayNight: the panel under the video follows the phone theme. The video area and its
         controls stay dark (black window, white controls), and so does the status bar above it -->
    <style name="Theme.SmartTubeDroid.Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF0000</item>
        <item name="colorSecondary">#FF0000</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@color/playback_panel_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/playback_light_panel</item>
    </style>

    <style name="Theme.SmartTubeDroid.Dialog" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
