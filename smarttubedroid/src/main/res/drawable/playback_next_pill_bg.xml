<?xml version="1.0" encoding="utf-8"?>
<!-- "Next: ..." label over the video: the same glass as the previous/next discs
     (playback_disc_bg), as a pill. See playback_glass_* in colors_playback.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/playback_glass_tint" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/playback_glass_sheen_bottom"
                android:startColor="@color/playback_glass_sheen_top" />
            <stroke
                android:width="1dp"
                android:color="@color/playback_glass_rim" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
