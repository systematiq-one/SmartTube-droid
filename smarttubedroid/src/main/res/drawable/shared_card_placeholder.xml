<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral thumbnail placeholder/error background; translucent gray works on light and dark themes.
     The corners double as the thumbnail's clip outline (VideoCardHolder sets clipToOutline). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#338E8E8E" />
    <corners android:radius="12dp" />
</shape>
